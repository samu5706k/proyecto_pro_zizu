@{
    ViewData["Title"] = "Inicio";
}

<div class="container mt-5">
    <div class="text-center">
        <h1 class="display-4">Sistema de Gestión del Gimnasio</h1>
        <p class="lead">
            Administración de socios, membresías y pagos
        </p>
    </div>

    <div class="row mt-5">

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h3>Socios</h3>
                    <p>Gestiona los socios del gimnasio.</p>
                    <a class="btn btn-primary" href="/Socios">
                        Ver socios
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h3>Membresías</h3>
                    <p>Administra los planes disponibles.</p>
                    <a class="btn btn-success" href="/Membresias">
                        Ver membresías
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h3>Pagos</h3>
                    <p>Controla los pagos de los socios.</p>
                    <a class="btn btn-warning" href="/Pagos">
                        Ver pagos
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>
