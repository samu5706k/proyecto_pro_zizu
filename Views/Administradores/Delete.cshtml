
@model Administrador
@{
    ViewData["Title"] = "Eliminar administrador";
}

<h2 class="mb-3">
    <i class="bi bi-trash-fill"></i> Eliminar administrador
</h2>

<div class="card tarjeta">
    <div class="card-body">
        <div class="alert alert-warning">
            ¿Estás seguro de que deseas eliminar este administrador?
            Esta acción no se puede deshacer.
        </div>

        <dl class="row">
            <dt class="col-sm-3">Nombre completo</dt>
            <dd class="col-sm-9">@Model.NombreCompleto</dd>

            <dt class="col-sm-3">CI</dt>
            <dd class="col-sm-9">@Model.Ci</dd>

            <dt class="col-sm-3">Teléfono</dt>
            <dd class="col-sm-9">@Model.Telefono</dd>

            <dt class="col-sm-3">Correo</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Cargo</dt>
            <dd class="col-sm-9">@Model.Cargo</dd>
        </dl>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Confirmar eliminación
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Cancelar
            </a>
        </form>
    </div>
</div>
