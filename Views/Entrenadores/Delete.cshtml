@model Entrenador
@{
    ViewData["Title"] = "Eliminar entrenador";
}

<h2 class="mb-3 text-danger"><i class="bi bi-exclamation-triangle-fill"></i> Eliminar entrenador</h2>

<div class="card tarjeta border-danger">
    <div class="card-body">
        <p class="fs-5">¿Seguro que quieres eliminar a <strong>@Model.NombreCompleto</strong>? Esta acción no se puede deshacer.</p>

        <dl class="row mb-4">
            <dt class="col-sm-3">CI</dt><dd class="col-sm-9">@Model.Ci</dd>
            <dt class="col-sm-3">Especialidad</dt><dd class="col-sm-9">@Model.Especialidad</dd>
            <dt class="col-sm-3">Teléfono</dt><dd class="col-sm-9">@Model.Telefono</dd>
            <dt class="col-sm-3">Contratación</dt><dd class="col-sm-9">@Model.FechaContratacion.ToString("dd/MM/yyyy")</dd>
        </dl>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Sí, eliminar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>
