
@model IEnumerable<gimnasio.Models.Pago>

@{
    ViewData["Title"] = "Pagos";
    string? buscar = ViewBag.Buscar as string;
    int? membresiaId = ViewBag.MembresiaId as int?;
    decimal total = Model.Sum(p => p.Monto);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>
        <i class="bi bi-cash-coin"></i>
        Gestión de pagos
    </h2>

    <a asp-action="Create"
       class="btn btn-warning">
        <i class="bi bi-plus-circle"></i>
        Registrar pago
    </a>
</div>

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success">@exito</div>
}

<div class="card mb-3">
    <div class="card-body">

        <form asp-action="Index" method="get"
              class="d-flex gap-2">

            @if (membresiaId.HasValue)
            {
                <input type="hidden"
                       name="membresiaId"
                       value="@membresiaId.Value" />
            }

            <input type="text"
                   name="buscar"
                   value="@buscar"
                   class="form-control"
                   placeholder="Buscar por socio, plan o método" />

            <button type="submit"
                    class="btn btn-primary">
                Buscar
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Limpiar
            </a>
        </form>

    </div>
</div>

<div class="row mb-3">
    <div class="col-md-4">
        <div class="card border-success">
            <div class="card-body">
                <h6>Total de pagos mostrados</h6>
                <h3 class="text-success">
                    Bs @total.ToString("N2")
                </h3>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="alert alert-info">
                No hay pagos registrados.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Socio</th>
                            <th>Plan</th>
                            <th>Fecha</th>
                            <th>Monto</th>
                            <th>Método</th>
                            <th>Referencia</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>@p.Id</td>
                                <td>@p.ClienteNombre</td>
                                <td>@p.Plan</td>
                                <td>
                                    @p.FechaPago.ToString("dd/MM/yyyy")
                                </td>
                                <td>
                                    Bs @p.Monto.ToString("N2")
                                </td>
                                <td>@p.Metodo</td>
                                <td>@p.Referencia</td>

                                <td class="text-nowrap">

                                    <a asp-action="Details"
                                       asp-route-id="@p.Id"
                                       class="btn btn-sm btn-info">
                                        Ver
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@p.Id"
                                       class="btn btn-sm btn-primary">
                                        Editar
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@p.Id"
                                       class="btn btn-sm btn-danger">
                                        Eliminar
                                    </a>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
