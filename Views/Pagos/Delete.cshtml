
@model gimnasio.Models.Pago

@{
    ViewData["Title"] = "Eliminar pago";
}

<h2 class="text-danger mb-3">Eliminar pago</h2>

<div class="card">
    <div class="card-body">

        <p>¿Deseas eliminar este pago?</p>

        <p><strong>Socio:</strong> @Model.ClienteNombre</p>
        <p><strong>Plan:</strong> @Model.Plan</p>

        <p>
            <strong>Importe:</strong>
            Bs @Model.Monto.ToString("N2")
        </p>

        <p>
            <strong>Fecha:</strong>
            @Model.FechaPago.ToString("dd/MM/yyyy")
        </p>

        <div class="alert alert-warning">
            Esta acción eliminará el registro del pago
            y modificará el saldo pendiente de la membresía.
        </div>

        <form asp-action="Delete"
              asp-route-id="@Model.Id"
              method="post">

            <button type="submit"
                    class="btn btn-danger">
                Confirmar eliminación
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancelar
            </a>

        </form>
    </div>
</div>
