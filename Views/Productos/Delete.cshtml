
@model gimnasio.Models.Producto

@{
    ViewData["Title"] = "Eliminar producto";
}

<h2 class="text-danger mb-3">
    Eliminar producto
</h2>

<div class="card">
    <div class="card-body">

        <p>
            ¿Estás seguro de que deseas eliminar
            el siguiente producto?
        </p>

        <dl class="row">

            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.Nombre</dd>

            <dt class="col-sm-3">Categoría</dt>
            <dd class="col-sm-9">@Model.Categoria</dd>

            <dt class="col-sm-3">Precio</dt>
            <dd class="col-sm-9">
                @Model.Precio.ToString("N2") Bs
            </dd>

            <dt class="col-sm-3">Stock</dt>
            <dd class="col-sm-9">@Model.Stock</dd>

        </dl>

        <div class="alert alert-warning">
            Esta acción eliminará definitivamente
            el producto de la base de datos.
        </div>

        <form asp-action="Delete"
              asp-route-id="@Model.Id"
              method="post">

            <button type="submit"
                    class="btn btn-danger">
                Sí, eliminar producto
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancelar
            </a>

        </form>

    </div>
</div>
