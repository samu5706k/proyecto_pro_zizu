
@model gimnasio.Models.Producto

<div asp-validation-summary="ModelOnly"
     class="text-danger mb-3"></div>

<input type="hidden" asp-for="Id" />

<div class="row g-3">

    <div class="col-md-6">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control"
               placeholder="Nombre del producto" />
        <span asp-validation-for="Nombre"
              class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Categoria" class="form-label"></label>
        <input asp-for="Categoria" class="form-control"
               placeholder="Ej. Suplementos, accesorios" />
        <span asp-validation-for="Categoria"
              class="text-danger"></span>
    </div>

    <div class="col-md-12">
        <label asp-for="Descripcion"
               class="form-label"></label>
        <textarea asp-for="Descripcion"
                  class="form-control"
                  rows="3"
                  placeholder="Descripción del producto"></textarea>
        <span asp-validation-for="Descripcion"
              class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Precio" class="form-label"></label>
        <input asp-for="Precio" type="number"
               min="0" step="0.01"
               class="form-control" />
        <span asp-validation-for="Precio"
              class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Stock" class="form-label"></label>
        <input asp-for="Stock" type="number"
               min="0" step="1"
               class="form-control" />
        <span asp-validation-for="Stock"
              class="text-danger"></span>
    </div>

    <div class="col-md-12">
        <div class="form-check form-switch">
            <input asp-for="Activo"
                   class="form-check-input" />
            <label asp-for="Activo"
                   class="form-check-label">
                Producto activo
            </label>
        </div>
    </div>

</div>
