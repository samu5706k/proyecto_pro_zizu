
@model IEnumerable<gimnasio.Models.Producto>

@{
    ViewData["Title"] = "Productos";
    string? buscar = ViewBag.Buscar as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>
        <i class="bi bi-box-seam"></i>
        Gestión de productos
    </h2>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i>
        Registrar producto
    </a>
</div>

@if (TempData["Exito"] is string mensaje)
{
    <div class="alert alert-success">
        @mensaje
    </div>
}

<div class="card mb-4">
    <div class="card-body">

        <form asp-action="Index" method="get"
              class="d-flex gap-2">

            <input type="text"
                   name="buscar"
                   value="@buscar"
                   class="form-control"
                   placeholder="Buscar productos por nombre o categoría" />

            <button type="submit" class="btn btn-dark">
                Buscar
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Limpiar
            </a>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="alert alert-info">
                No hay productos registrados o no se encontraron resultados.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Producto</th>
                            <th>Categoría</th>
                            <th>Precio</th>
                            <th>Stock</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>@p.Id</td>
                                <td>@p.Nombre</td>
                                <td>@p.Categoria</td>
                                <td>@p.Precio.ToString("N2") Bs</td>

                                <td>
                                    @if (p.Stock > 0)
                                    {
                                        <span class="badge bg-success">
                                            @p.Stock disponibles
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Sin stock
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (p.Activo)
                                    {
                                        <span class="badge bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactivo
                                        </span>
                                    }
                                </td>

                                <td class="text-nowrap">

                                    <a asp-action="Details"
                                       asp-route-id="@p.Id"
                                       class="btn btn-sm btn-info">
                                        Ver
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@p.Id"
                                       class="btn btn-sm btn-primary">
                                        Editar
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@p.Id"
                                       class="btn btn-sm btn-danger">
                                        Eliminar
                                    </a>

                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            <p class="text-muted">
                Total de productos mostrados: @Model.Count()
            </p>
        }
    </div>
</div>
